{
  "name": "crud-application-framework",
  "version": "1.0.0",
  "description": "Full-stack CRUD application with proper infrastructure setup and standardized project conventions",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "dev:framework": "cd crud-framework && npm run dev",
    "install:all": "npm run install:backend && npm run install:frontend && npm run install:framework",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install", 
    "install:framework": "cd crud-framework && npm install",
    "test": "npm run test:backend && npm run test:frontend && npm run test:framework",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:framework": "cd crud-framework && npm test",
    "build": "npm run build:backend && npm run build:frontend && npm run build:framework",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:framework": "cd crud-framework && npm run build",
    "lint": "npm run lint:backend && npm run lint:frontend && npm run lint:framework",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:framework": "cd crud-framework && npm run lint",
    "migrate": "cd backend && npm run migrate",
    "migrate:rollback": "cd backend && npm run migrate:rollback",
    "seed": "cd backend && npm run seed",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules crud-framework/node_modules",
    "setup": "npm run install:all && npm run migrate"
  },
  "workspaces": [
    "backend",
    "frontend",
    "crud-framework"
  ],
  "keywords": [
    "crud",
    "api",
    "fullstack",
    "express",
    "react",
    "infrastructure",
    "framework",
    "javascript",
    "standardized"
  ],
  "author": "Development Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/crud-application-framework.git"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  }
}